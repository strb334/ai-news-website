<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results - AI News</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%232563eb'><path d='M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z'/></svg>">
</head>
<body>
    <header class="header">
        <nav class="nav">
            <a href="/" class="logo">
                <div class="logo-icon">AI</div>
                News
            </a>
            <div class="nav-links">
                <a href="/" class="nav-link">Home</a>
                <a href="/about" class="nav-link">About</a>
            </div>
            <div class="search-container">
                <input type="text" class="search-input" id="nav-search" placeholder="Search AI news...">
                <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
            </div>
            <div class="language-selector">
                <button class="lang-btn" data-lang="en" onclick="setLanguage('en')">EN</button>
                <button class="lang-btn" data-lang="sv" onclick="setLanguage('sv')">SV</button>
                <button class="lang-btn" data-lang="de" onclick="setLanguage('de')">DE</button>
            </div>
        </nav>
    </header>

    <main>
        <section class="news">
            <div class="container">
                <h1 class="section-title">Search Results</h1>
                <div class="news-grid" id="search-results">
                    <div class="loading">
                        <div class="spinner"></div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>AI News</h3>
                    <p>Your trusted source for artificial intelligence news and updates.</p>
                </div>
                <div class="footer-section">
                    <h3>Quick Links</h3>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/search">Search</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Categories</h3>
                    <ul class="footer-links" id="footer-categories">
                        <li><a href="/category/machine-learning">Machine Learning</a></li>
                        <li><a href="/category/deep-learning">Deep Learning</a></li>
                        <li><a href="/category/language-models">Language Models</a></li>
                        <li><a href="/category/computer-vision">Computer Vision</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Stay Updated</h3>
                    <p>Subscribe to our newsletter for the latest AI news delivered to your inbox.</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 AI News. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        let searchResults = [];
        
        document.addEventListener('DOMContentLoaded', function() {
            performSearch('');
        });
        
        async function performSearch(query) {
            const searchResultsContainer = document.getElementById('search-results');
            searchResultsContainer.innerHTML = `
                <div class="loading">
                    <div class="spinner"></div>
                </div>
            `;
            
            if (!query.trim()) {
                searchResultsContainer.innerHTML = `
                    <div class="container">
                        <p>Please enter a search term to find news articles.</p>
                    </div>
                `;
                return;
            }
            
            try {
                // For demo purposes, use sample data
                const sampleResults = [
                    {
                        id: 1,
                        title: "OpenAI Announces GPT-5 Development",
                        description: "OpenAI has revealed plans to develop GPT-5, the next generation of their language models, with enhanced capabilities and improved safety measures.",
                        category: "Language Models",
                        image: "https://picsum.photos/seed/openai/800/400",
                        date: "2024-01-15",
                        readTime: "5 min read",
                        tags: ["OpenAI", "GPT-5", "Language Models"]
                    }
                ].filter(item => 
                    item.title.toLowerCase().includes(query.toLowerCase()) ||
                    item.description.toLowerCase().includes(query.toLowerCase()) ||
                    item.tags.some(tag => tag.toLowerCase().includes(query.toLowerCase()))
                );
                
                searchResults = sampleResults;
                displaySearchResults(sampleResults);
            } catch (error) {
                console.error('Error searching news:', error);
                searchResultsContainer.innerHTML = `
                    <div class="container">
                        <p>Error searching for news articles. Please try again later.</p>
                    </div>
                `;
            }
        }
        
        function displaySearchResults(results) {
            const searchResultsContainer = document.getElementById('search-results');
            if (results.length === 0) {
                searchResultsContainer.innerHTML = `
                    <div class="container">
                        <h2>No results found for ""</h2>
                        <p>Try searching with different keywords or browse our categories.</p>
                    </div>
                `;
                return;
            }
            
            searchResultsContainer.innerHTML = `
                <div class="container">
                    <p class="section-title">Found ${results.length} result(s) for ""</p>
                    <div class="news-grid">
                        ${results.map(item => `
                            <article class="news-card animate-in">
                                <img src="${item.image}" alt="${item.title}" class="news-image" loading="lazy">
                                <div class="news-content">
                                    <span class="news-category">${item.category}</span>
                                    <a href="#" class="news-title" onclick="viewNews(${item.id})">${item.title}</a>
                                    <p class="news-description">${item.description}</p>
                                    <div class="news-meta">
                                        <span class="news-date">📅 ${new Date(item.date).toLocaleDateString()}</span>
                                        <span class="news-read-time">📖 ${item.readTime}</span>
                                    </div>
                                </div>
                            </article>
                        ").join('')}
                    </div>
                </div>
            `;
        }
        
        function viewNews(id) {
            console.log('Viewing news article:', id);
        }
        
        // Setup navigation search
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('nav-search');
            if (searchInput) {
                let timeoutId;
                searchInput.addEventListener('input', function() {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => {
                        const query = this.value;
                        if (query) {
                            window.location.href = '/search?q=' + encodeURIComponent(query);
                        }
                    }, 500);
                });
            }
        });
    </script>
</body>
</html>