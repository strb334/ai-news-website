<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category - AI News</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%232563eb'><path d='M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z'/></svg>">
</head>
<body>
    <header class="header">
        <nav class="nav">
            <a href="/" class="logo">
                <div class="logo-icon">AI</div>
                News
            </a>
            <div class="nav-links">
                <a href="/" class="nav-link">Home</a>
                <a href="/about" class="nav-link">About</a>
            </div>
            <div class="search-container">
                <input type="text" class="search-input" id="nav-search" placeholder="Search AI news...">
                <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
            </div>
            <div class="language-selector">
                <button class="lang-btn" data-lang="en" onclick="setLanguage('en')">EN</button>
                <button class="lang-btn" data-lang="sv" onclick="setLanguage('sv')">SV</button>
                <button class="lang-btn" data-lang="de" onclick="setLanguage('de')">DE</button>
            </div>
        </nav>
    </header>

    <main>
        <section class="news">
            <div class="container">
                <h1 class="section-title">Category: Machine Learning</h1>
                <div class="news-grid" id="category-news">
                    <div class="loading">
                        <div class="spinner"></div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>AI News</h3>
                    <p>Your trusted source for artificial intelligence news and updates.</p>
                </div>
                <div class="footer-section">
                    <h3>Quick Links</h3>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/search">Search</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Categories</h3>
                    <ul class="footer-links" id="footer-categories">
                        <li><a href="/category/machine-learning">Machine Learning</a></li>
                        <li><a href="/category/deep-learning">Deep Learning</a></li>
                        <li><a href="/category/language-models">Language Models</a></li>
                        <li><a href="/category/computer-vision">Computer Vision</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Stay Updated</h3>
                    <p>Subscribe to our newsletter for the latest AI news delivered to your inbox.</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 AI News. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        let categoryNews = [];
        
        document.addEventListener('DOMContentLoaded', function() {
            loadCategoryNews('Machine Learning');
        });
        
        async function loadCategoryNews(category) {
            const categoryNewsContainer = document.getElementById('category-news');
            categoryNewsContainer.innerHTML = `
                <div class="loading">
                    <div class="spinner"></div>
                </div>
            `;
            
            // Sample data for demo
            const sampleNews = [
                {
                    id: 1,
                    title: "Example Machine Learning News Article 1",
                    description: "This is an example news article about Machine Learning. This demonstrates how news articles would appear in this category.",
                    category: category,
                    image: "https://picsum.photos/seed/category1/800/400",
                    date: "2024-01-15",
                    readTime: "5 min read",
                    tags: [category, "Example", "Demo"]
                },
                {
                    id: 2,
                    title: "Example Machine Learning News Article 2",
                    description: "Another example news article showcasing the Machine Learning category functionality.",
                    category: category,
                    image: "https://picsum.photos/seed/category2/800/400",
                    date: "2024-01-14",
                    readTime: "4 min read",
                    tags: [category, "Example", "Demo"]
                }
            ];
            
            categoryNews = sampleNews;
            displayCategoryNews(sampleNews);
        }
        
        function displayCategoryNews(news) {
            const categoryNewsContainer = document.getElementById('category-news');
            categoryNewsContainer.innerHTML = `
                <div class="news-grid">
                    ${news.map(item => `
                        <article class="news-card animate-in">
                            <img src="${item.image}" alt="${item.title}" class="news-image" loading="lazy">
                            <div class="news-content">
                                <span class="news-category">${item.category}</span>
                                <a href="#" class="news-title" onclick="viewNews(${item.id})">${item.title}</a>
                                <p class="news-description">${item.description}</p>
                                <div class="news-meta">
                                    <span class="news-date">📅 ${new Date(item.date).toLocaleDateString()}</span>
                                    <span class="news-read-time">📖 ${item.readTime}</span>
                                </div>
                            </div>
                        </article>
                    ").join('')}
                </div>
            `;
        }
        
        function viewNews(id) {
            console.log('Viewing news article:', id);
        }
        
        // Setup navigation search
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('nav-search');
            if (searchInput) {
                let timeoutId;
                searchInput.addEventListener('input', function() {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => {
                        const query = this.value;
                        if (query) {
                            window.location.href = '/search?q=' + encodeURIComponent(query);
                        }
                    }, 500);
                });
            }
        });
    </script>
</body>
</html>